---
import { localizeHref } from '../lib/site-content';

interface Props {
  title: string;
  brand?: string;
  oneLiner?: string;
  keywords?: string[];
  mainImage?: string;
  slug: string;
  locale: string;
  defaultLocale: string;
}

const {
  title,
  brand,
  oneLiner,
  keywords = [],
  mainImage,
  slug,
  locale,
  defaultLocale,
} = Astro.props;

const href = localizeHref(locale, `/products/${slug}`, defaultLocale, [
  { code: defaultLocale },
]);
---

<article class="product-card">
  {mainImage && (
    <a href={href} class="product-image-wrap" aria-label={title}>
      <img src={mainImage} alt={title} loading="lazy" class="product-image" />
    </a>
  )}
  <div class="product-copy">
    {brand && <span class="product-brand">{brand}</span>}
    <h3 class="product-title"><a href={href}>{title}</a></h3>
    {oneLiner && <p class="product-summary">{oneLiner}</p>}
    {keywords.length > 0 && (
      <div class="product-tags">
        {keywords.slice(0, 3).map((keyword) => <span>{keyword}</span>)}
      </div>
    )}
  </div>
</article>

<style>
  .product-card {
    overflow: hidden;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    transition: var(--transition-smooth);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(18, 43, 37, 0.1);
  }

  .product-image-wrap {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-primary-soft);
  }

  .product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .product-image {
    transform: scale(1.04);
  }

  .product-copy {
    display: grid;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .product-brand {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .product-title {
    font-size: 1.1rem;
  }

  .product-summary {
    color: var(--color-text-muted);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .product-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .product-tags span {
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }
</style>
