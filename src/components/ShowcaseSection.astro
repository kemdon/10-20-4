---
interface ShowcaseItem {
  tag?: string;
  title?: string;
  body?: string;
  image?: string;
}

interface Props {
  label?: string;
  title?: string;
  body?: string;
  showcases: ShowcaseItem[];
}

const { label, title, body, showcases } = Astro.props;
const visibleShowcases = showcases.filter((item) => item.title || item.body || item.image);
---

{visibleShowcases.length > 0 && (
  <section id="showcase" class="showcase-section section-padding">
    <div class="container">
      <div class="showcase-head fade-in-up">
        {label && <span class="section-kicker">{label}</span>}
        {title && <h2 class="showcase-title">{title}</h2>}
        {body && <p class="showcase-body">{body}</p>}
      </div>

      <div class="showcase-grid">
        {visibleShowcases.map((item, index) => (
          <article class="showcase-card fade-in-up" style={`transition-delay: ${index * 100}ms`}>
            {item.image && (
              <div class="showcase-image-wrap">
                <img src={item.image} alt={item.title || 'Showcase image'} class="showcase-image" />
              </div>
            )}
            <div class="showcase-copy">
              {item.tag && <span class="showcase-tag">{item.tag}</span>}
              {item.title && <h3 class="showcase-card-title">{item.title}</h3>}
              {item.body && <p class="showcase-card-body">{item.body}</p>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .showcase-head {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
    margin-bottom: 3rem;
  }

  .section-kicker {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .showcase-title {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
  }

  .showcase-body,
  .showcase-card-body {
    color: var(--color-text-muted);
    line-height: 1.9;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .showcase-card {
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border-soft);
    transition: var(--transition-smooth);
  }

  .showcase-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 20px 44px rgba(18, 43, 37, 0.1);
  }

  .showcase-image-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-primary-soft);
  }

  .showcase-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .showcase-card:hover .showcase-image {
    transform: scale(1.04);
  }

  .showcase-copy {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem 1.9rem 2rem;
  }

  .showcase-tag {
    display: inline-flex;
    align-self: flex-start;
    padding: 0.25rem 0.8rem;
    border-radius: 999px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .showcase-card-title {
    font-size: 1.3rem;
  }

  @media (max-width: 960px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
