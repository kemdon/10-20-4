---
interface StatItem {
  value?: string;
  label?: string;
  detail?: string;
}

interface Props {
  label?: string;
  title?: string;
  stats: StatItem[];
}

const { label, title, stats } = Astro.props;
const visibleStats = stats.filter((item) => item.value || item.label || item.detail);
---

{visibleStats.length > 0 && (
  <section class="stats-section section-padding">
    <div class="container">
      <div class="stats-head fade-in-up">
        {label && <span class="section-kicker">{label}</span>}
        {title && <h2 class="stats-title">{title}</h2>}
      </div>

      <div class="stats-grid">
        {visibleStats.map((item, index) => (
          <article class="stat-card fade-in-up" style={`transition-delay: ${index * 90}ms`}>
            {item.value && <div class="stat-value">{item.value}</div>}
            {item.label && <h3 class="stat-label">{item.label}</h3>}
            {item.detail && <p class="stat-detail">{item.detail}</p>}
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .stats-section {
    background: var(--color-bg-deep);
    color: rgba(255, 255, 255, 0.85);
  }

  .stats-head {
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    margin-bottom: 3.5rem;
  }

  .section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #d9a05b;
  }

  .section-kicker::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: #d9a05b;
    border-radius: 1px;
  }

  .stats-title {
    font-size: clamp(1.9rem, 3.5vw, 2.6rem);
    color: #fff;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .stat-card {
    padding: 0;
    border: none;
    background: transparent;
    box-shadow: none;
    min-height: 0;
    border-radius: 0;
  }

  .stat-value {
    font-family: var(--font-num);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    line-height: 1.1;
    color: #d9a05b;
    margin-bottom: 0.9rem;
  }

  .stat-label {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .stat-detail {
    color: rgba(255, 255, 255, 0.55);
    line-height: 1.8;
    font-size: 0.9rem;
  }

  @media (max-width: 1024px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
  }

  @media (max-width: 900px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat-card {
      min-height: auto;
    }
  }
</style>
