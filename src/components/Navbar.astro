---
import type { SiteSettings } from '../lib/site-content';
import { localizeHref, stripLocaleFromPath } from '../lib/site-content';

interface Props {
  site: SiteSettings;
  locale: string;
  currentPath: string;
}

const { site, locale, currentPath } = Astro.props;
const hasBrand = Boolean(site.brandName);
const navItems = site.navigation.filter((item) => item.label);
const shouldRender = hasBrand || navItems.length > 0;
const basePath = stripLocaleFromPath(currentPath || '/', site.supportedLocales);
const localeLinks = site.supportedLocales.map((item) => ({
  ...item,
  href: localizeHref(item.code, basePath, site.defaultLocale, site.supportedLocales),
  active: item.code.toLowerCase() === locale.toLowerCase(),
}));
const activeLocale = localeLinks.find((item) => item.active) || localeLinks[0];

const cleanPath = (value: string) => value.replace(/\/+$/, '') || '/';
const current = cleanPath(basePath);
const isActive = (href: string) => {
  const target = cleanPath(href || '/');
  if (target === '/') return current === '/';
  return current === target || current.startsWith(`${target}/`);
};
---

{shouldRender && (
  <header class="navbar-wrapper">
    <div class="topbar">
      <div class="container topbar-inner">
        <span>欢迎访问硕学教育官方网站</span>
        <span>专注成人学历教育 · 助力人生进阶</span>
      </div>
    </div>
    <div class="container navbar-container">
      {hasBrand ? (
        <a href={localizeHref(locale, '/', site.defaultLocale, site.supportedLocales)} class="brand-logo">
          <img src="/assets/images/brand-logo.webp" alt={site.brandName} width="180" height="52" />
        </a>
      ) : (
        <div></div>
      )}

      <nav class="nav-menu" id="nav-menu" aria-label="主导航">
        {navItems.map((item) => {
          const href = localizeHref(locale, item.href || '/', site.defaultLocale, site.supportedLocales);
          const active = isActive(item.href || '/');
          return (
            <a href={href} class={`nav-link ${item.isPrimary ? 'primary-button' : ''} ${active ? 'active' : ''}`} aria-current={active ? 'page' : undefined}>
              {item.label}
            </a>
          );
        })}
      </nav>

      <div class="nav-controls">
        {localeLinks.length > 1 && (
          <details class="locale-switcher" aria-label={site.localeSwitcherLabel || 'Language'}>
            <summary class="locale-current">{activeLocale?.label || activeLocale?.code || locale}</summary>
            <div class="locale-menu">
              {localeLinks.map((item) => (
                <a href={item.href} class={`locale-link ${item.active ? 'active' : ''}`} aria-current={item.active ? 'page' : undefined}>
                  <span>{item.label || item.code}</span>
                  <span class="locale-code">{item.code}</span>
                </a>
              ))}
            </div>
          </details>
        )}

        <button
          class="hamburger"
          id="hamburger-btn"
          aria-label={site.mobileMenuLabel}
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav" aria-label="移动端导航">
        {navItems.map((item) => (
          <a
            href={localizeHref(locale, item.href || '/', site.defaultLocale, site.supportedLocales)}
            class={`mobile-nav-link ${item.isPrimary ? 'mobile-primary-button' : ''} ${isActive(item.href || '/') ? 'active' : ''}`}
          >
            {item.label}
          </a>
        ))}
        {localeLinks.length > 1 && (
          <div class="mobile-locales">
            {localeLinks.map((item) => (
              <a href={item.href} class={`mobile-locale-link ${item.active ? 'active' : ''}`}>
                <span>{item.label || item.code}</span>
                <span class="locale-code">{item.code}</span>
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
  </header>
)}

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');

  const setMenuState = (isOpen: boolean) => {
    menu?.classList.toggle('open', isOpen);
    btn?.classList.toggle('active', isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  };

  btn?.addEventListener('click', () => {
    setMenuState(!menu?.classList.contains('open'));
  });

  const mobileLinks = menu?.querySelectorAll('.mobile-nav-link');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });
</script>

<style>
  .navbar-wrapper {
    position: sticky;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: #fff;
    box-shadow: 0 2px 12px rgba(18, 52, 96, 0.07);
  }
  .topbar { background: #12386C; color: rgba(255, 255, 255, 0.72); font-size: 0.72rem; letter-spacing: 0.04em; }
  .topbar-inner { display: flex; align-items: center; justify-content: space-between; min-height: 1.85rem; padding: 0 1.5rem; }
  .navbar-container {
    max-width: var(--container-max);
    margin: 0 auto;
    min-height: 4.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 1.5rem;
  }
  .brand-logo { display: inline-flex; align-items: center; white-space: nowrap; flex: none; }
  .brand-logo img { width: auto; height: 3rem; flex: none; object-fit: contain; }
  .nav-menu { display: flex; align-items: center; gap: 0; }
  .nav-link {
    position: relative;
    display: inline-block;
    padding: 0.45rem 0.62rem;
    font-size: 0.83rem;
    font-weight: 500;
    color: #46586E;
    white-space: nowrap;
    border-radius: 4px;
  }
  .nav-link:hover { color: #1D4E89; background: #F2F6FC; }
  .nav-link.active:not(.primary-button) { color: #16437D; font-weight: 700; }
  .nav-link.active:not(.primary-button)::after { content: ''; position: absolute; left: 50%; bottom: 0.05rem; transform: translateX(-50%); width: 1.1rem; height: 2px; border-radius: 2px; background: #C9A65C; }
  .primary-button { margin-left: 0.35rem; background: linear-gradient(100deg, #2E6FBF, #1B4F94); color: #fff; padding: 0.5rem 1.15rem; border-radius: 999px; font-weight: 600; }
  .primary-button:hover { color: #fff; filter: brightness(1.08); }
  .locale-switcher { display: none; }
  .nav-controls { display: flex; align-items: center; gap: 0.75rem; }
  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 0.5rem;
  }
  .hamburger-line { display: block; width: 100%; height: 2px; background: var(--color-text); border-radius: 2px; transition: transform 0.3s ease, opacity 0.3s ease; }
  .hamburger.active .hamburger-line:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hamburger.active .hamburger-line:nth-child(2) { opacity: 0; }
  .hamburger.active .hamburger-line:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu {
    display: none;
    position: fixed;
    top: 6.35rem;
    left: 0;
    width: 100%;
    height: calc(100vh - 6.35rem);
    background: #fff;
    z-index: 999;
    overflow-y: auto;
  }
  .mobile-menu.open { display: block; }
  .mobile-nav { display: flex; flex-direction: column; padding: 1rem 1.5rem; gap: 0.25rem; }
  .mobile-nav-link { display: block; padding: 0.9rem 0.75rem; font-size: 1.05rem; font-weight: 500; color: var(--color-text); border-bottom: 1px solid var(--color-border-soft); }
  .mobile-nav-link.active { color: #1D4E89; font-weight: 700; }
  .mobile-nav-link:hover { color: #1D4E89; }
  .mobile-primary-button { background: #1D4E89; color: #fff; text-align: center; border-bottom: none; border-radius: 6px; margin-top: 0.75rem; }
  .mobile-locales { display: none; }
  body.menu-open { overflow: hidden; }
  @media (max-width: 1080px) {
    .nav-menu { display: none; }
    .hamburger { display: flex; }
  }
  @media (max-width: 560px) {
    .topbar-inner span:last-child { display: none; }
    .brand-logo img { height: 2.45rem; }
  }
</style>
