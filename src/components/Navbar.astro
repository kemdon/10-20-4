---
import type { SiteSettings } from '../lib/site-content';
import { localizeHref, stripLocaleFromPath } from '../lib/site-content';

interface Props {
  site: SiteSettings;
  locale: string;
  currentPath: string;
}

const { site, locale, currentPath } = Astro.props;
const hasBrand = Boolean(site.brandName);
const navItems = site.navigation.filter((item) => item.label);
const shouldRender = hasBrand || navItems.length > 0;
const basePath = stripLocaleFromPath(currentPath || '/', site.supportedLocales);
const localeLinks = site.supportedLocales.map((item) => ({
  ...item,
  href: localizeHref(item.code, basePath, site.defaultLocale, site.supportedLocales),
  active: item.code.toLowerCase() === locale.toLowerCase(),
}));
const activeLocale = localeLinks.find((item) => item.active) || localeLinks[0];
---

{shouldRender && (
  <header class="navbar-wrapper glass-effect">
    <div class="container navbar-container">
      {hasBrand ? (
        <a href={localizeHref(locale, '/', site.defaultLocale, site.supportedLocales)} class="brand-logo">
          {site.brandName}
        </a>
      ) : (
        <div></div>
      )}

      <nav class="nav-menu" id="nav-menu">
        {navItems.map((item) => (
          <a
            href={localizeHref(locale, item.href || '/', site.defaultLocale, site.supportedLocales)}
            class={`nav-link ${item.isPrimary ? 'primary-button' : ''}`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="nav-controls">
        {localeLinks.length > 1 && (
          <details class="locale-switcher" aria-label={site.localeSwitcherLabel || 'Language'}>
            <summary class="locale-current">{activeLocale?.label || activeLocale?.code || locale}</summary>
            <div class="locale-menu">
              {localeLinks.map((item) => (
                <a href={item.href} class={`locale-link ${item.active ? 'active' : ''}`} aria-current={item.active ? 'page' : undefined}>
                  <span>{item.label || item.code}</span>
                  <span class="locale-code">{item.code}</span>
                </a>
              ))}
            </div>
          </details>
        )}

        <button
          class="hamburger"
          id="hamburger-btn"
          aria-label={site.mobileMenuLabel}
          aria-controls="mobile-menu"
          aria-expanded="false"
          type="button"
        >
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>
      </div>
    </div>

    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav">
        {navItems.map((item) => (
          <a
            href={localizeHref(locale, item.href || '/', site.defaultLocale, site.supportedLocales)}
            class={`mobile-nav-link ${item.isPrimary ? 'mobile-primary-button' : ''}`}
          >
            {item.label}
          </a>
        ))}
        {localeLinks.length > 1 && (
          <div class="mobile-locales">
            {localeLinks.map((item) => (
              <a href={item.href} class={`mobile-locale-link ${item.active ? 'active' : ''}`}>
                <span>{item.label || item.code}</span>
                <span class="locale-code">{item.code}</span>
              </a>
            ))}
          </div>
        )}
      </nav>
    </div>
  </header>
)}

<script>
  const btn = document.getElementById('hamburger-btn');
  const menu = document.getElementById('mobile-menu');

  const setMenuState = (isOpen: boolean) => {
    menu?.classList.toggle('open', isOpen);
    btn?.classList.toggle('active', isOpen);
    btn?.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  };

  btn?.addEventListener('click', () => {
    setMenuState(!menu?.classList.contains('open'));
  });

  const mobileLinks = menu?.querySelectorAll('.mobile-nav-link');
  mobileLinks?.forEach(link => {
    link.addEventListener('click', () => {
      setMenuState(false);
    });
  });
</script>

<style>
  .navbar-wrapper {
    position: fixed;
    top: 0.75rem;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: transparent;
    border-bottom: none;
    transition: var(--transition-smooth);
  }

  .navbar-container {
    height: auto;
    min-height: 3.5rem;
    max-width: 68rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem 0.5rem 1.25rem;
    background: rgba(250, 247, 241, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border: 1px solid var(--color-border-soft);
    border-radius: 999px;
    box-shadow: 0 8px 28px rgba(18, 43, 37, 0.08);
  }

  .brand-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-primary-dark);
    letter-spacing: 0.06em;
  }

  .brand-logo::before {
    content: '';
    width: 0.55rem;
    height: 1.5rem;
    border-radius: 3px;
    background: var(--color-primary);
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .locale-switcher { position: relative; display: none; }
  .locale-current { display: inline-flex; align-items: center; min-height: 2.5rem; max-width: 12rem; padding: 0 0.9rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-muted); font-size: 0.78rem; font-weight: 700; cursor: pointer; list-style: none; }
  .locale-current::-webkit-details-marker { display: none; }
  .locale-menu { position: absolute; top: calc(100% + 0.55rem); right: 0; display: grid; gap: 0.25rem; width: min(22rem, calc(100vw - 2rem)); max-height: min(28rem, calc(100vh - 7rem)); overflow: auto; padding: 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface); box-shadow: 0 20px 60px rgba(18, 43, 37, 0.14); }
  .locale-link { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 2.25rem; padding: 0 0.65rem; border-radius: calc(var(--radius-md) * 0.75); font-size: 0.82rem; color: var(--color-text-muted); }
  .locale-link:hover, .locale-link.active { color: var(--color-text); background: rgba(30, 43, 39, 0.06); }
  .locale-code { font-size: 0.72rem; opacity: 0.62; text-transform: uppercase; }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
    position: relative;
    padding: 0.35rem 0;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
  }

  .primary-button {
    background: var(--color-primary);
    color: #fff;
    padding: 0.5rem 0.875rem;
    font-size: 0.875rem;
    border-radius: 999px;
  }

  .primary-button::after {
    display: none;
  }

  .primary-button:hover {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .nav-controls {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.5rem;
    height: 2.5rem;
    background: none;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    cursor: pointer;
    padding: 0.5rem;
  }

  .hamburger-line {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--color-text);
    border-radius: 2px;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .hamburger.active .hamburger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .hamburger.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .hamburger.active .hamburger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    position: fixed;
    top: 4.5rem;
    left: 0;
    width: 100%;
    height: calc(100vh - 4.25rem);
    background: var(--color-bg);
    z-index: 999;
    overflow-y: auto;
    opacity: 0;
    transform: translateY(-8px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mobile-menu.open {
    display: block;
    opacity: 1;
    transform: translateY(0);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 1.5rem;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 1rem;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--color-text);
    border-radius: var(--radius-md);
    transition: background 0.2s ease;
  }

  .mobile-nav-link:hover {
    background: rgba(30, 43, 39, 0.06);
  }

  .mobile-primary-button {
    background: var(--color-primary);
    color: #fff;
    text-align: center;
  }

  .mobile-primary-button:hover {
    background: var(--color-primary-dark);
    color: #fff;
  }

  .mobile-locales {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .mobile-locale-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .mobile-locale-link.active {
    color: var(--color-text);
    background: rgba(30, 43, 39, 0.06);
  }

  body.menu-open {
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .nav-menu {
      display: none;
    }

    .hamburger {
      display: flex;
    }
  }
</style>