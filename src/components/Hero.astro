---
interface Props {
  label?: string;
  title?: string;
  body?: string;
  image?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  tertiaryLabel?: string;
  tertiaryHref?: string;
  quaternaryLabel?: string;
  quaternaryHref?: string;
  scrollText?: string;
}

const {
  label,
  title,
  body,
  image,
  primaryLabel,
  primaryHref = '/products',
  secondaryLabel,
  secondaryHref = '/about',
  tertiaryLabel,
  tertiaryHref = '/faq',
  quaternaryLabel,
  quaternaryHref = '/contact',
} = Astro.props;

const hasHeroContent = Boolean(
  label ||
  title ||
  body ||
  image ||
  primaryLabel ||
  secondaryLabel ||
  tertiaryLabel ||
  quaternaryLabel,
);
---

{hasHeroContent && (
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-text-block">
        {label && <span class="hero-label">{label}</span>}
        {title && <h1 class="hero-title">{title}</h1>}
        {body && <p class="hero-body">{body}</p>}
        {(primaryLabel || secondaryLabel || tertiaryLabel || quaternaryLabel) && (
          <div class="hero-actions">
            {primaryLabel && <a href={primaryHref} class="btn btn-primary">{primaryLabel}</a>}
            {secondaryLabel && <a href={secondaryHref} class="btn btn-ghost">{secondaryLabel}</a>}
            {tertiaryLabel && <a href={tertiaryHref} class="btn btn-plain">{tertiaryLabel}</a>}
          </div>
        )}
        <p class="hero-note">从中专、专科、本科到在职研究生 · 20 家分校 · 覆盖浙东多地</p>
      </div>

      {image && (
        <div class="hero-media">
          <div class="hero-image-frame">
            <img src={image} alt={title || ''} class="hero-image" />
          </div>
          <div class="hero-badge">
            <span class="hero-badge-num">2012</span>
            <span class="hero-badge-text">创立于宁波<br />深耕成人继续教育</span>
          </div>
        </div>
      )}
    </div>
  </section>
)}

<style>
  .hero-section {
    padding: 9.5rem 0 5.5rem;
    background: var(--color-bg);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: 4.5rem;
    align-items: center;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-primary);
    letter-spacing: 0.08em;
    margin-bottom: 1.5rem;
  }

  .hero-label::before {
    content: '';
    width: 1.75rem;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
  }

  .hero-title {
    font-size: clamp(1.875rem, 4vw, 3rem);
    line-height: 1.33;
    letter-spacing: 0.01em;
    max-width: 680px;
    background: linear-gradient(90deg, #000000, #666666);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 1.5rem;
  }

  .hero-body {
    font-size: 1.08rem;
    color: var(--color-text-muted);
    line-height: 2;
    margin-bottom: 2.5rem;
    max-width: 680px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .hero-note {
    margin-top: 2.25rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.75rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .btn-primary {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-primary:hover {
    background: var(--color-primary-dark);
    transform: translateY(-2px);
  }

  .btn-ghost {
    color: var(--color-primary);
    background: transparent;
    padding: 0.5rem 0.75rem;
  }

  .btn-ghost:hover {
    color: var(--color-primary-dark);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .btn-ghost:hover {
    background: var(--color-primary);
    color: #fff;
  }

  .btn-plain {
    color: var(--color-text-muted);
    padding-inline: 0.75rem;
  }

  .btn-plain:hover {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-media {
    position: relative;
  }

  .hero-image-frame {
    border-radius: 1.5rem;
    overflow: hidden;
    aspect-ratio: 4 / 3.2;
    box-shadow:
      0 24px 60px rgba(18, 43, 37, 0.18),
      0 4px 14px rgba(18, 43, 37, 0.08);
  }

  /* 相框式错位描边，增加编辑感 */
  .hero-image-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 1.5rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    pointer-events: none;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-badge {
    position: absolute;
    left: -1.25rem;
    bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 1.4rem;
    background: #fff;
    border-radius: 1rem;
    box-shadow: 0 18px 40px rgba(18, 43, 37, 0.16);
  }

  .hero-badge-num {
    font-family: var(--font-num);
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }

  .hero-badge-text {
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 960px) {
    .hero-section {
      padding: 7.5rem 0 4rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero-media {
      max-width: 34rem;
    }

    .hero-badge {
      left: 1rem;
    }
  }
</style>
