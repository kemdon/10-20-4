---
import type { SiteSettings } from '../lib/site-content';

interface Props {
  site: SiteSettings;
  locale: string;
}

const { site } = Astro.props;
const motto = site.footerMotto || '';
const year = new Date().getFullYear();
const copyright = site.copyrightLine?.includes('©')
  ? site.copyrightLine
  : `© ${year} ${site.copyrightLine || ''}`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      {site.brandName && <h3 class="footer-title">{site.brandName}</h3>}
      {motto && <p class="footer-motto">{motto}</p>}
      {site.footerBody && <p class="footer-desc">{site.footerBody}</p>}
    </div>

    <div class="footer-col">
      <h4 class="footer-col-title">快速导航</h4>
      <ul class="footer-nav">
        {(site.footerLinks || []).map((link) => (
          <li><a href={link.href || '/'}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-col-title">服务范围</h4>
      <ul class="footer-nav">
        <li>成人高考 · 函授</li>
        <li>自学考试 · 国家开放大学</li>
        <li>成人中专 · 同等学力申硕</li>
        <li>职业技能培训 · 企业内训</li>
      </ul>
    </div>

    <div class="footer-col">
      <h4 class="footer-col-title">联系我们</h4>
      <ul class="footer-nav">
        {site.footerAddress && <li>{site.footerAddress}</li>}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    {copyright && <p class="copyright">{copyright}</p>}
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-bg-deep);
    color: rgba(255, 255, 255, 0.82);
    padding: 4.5rem 0 2.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr 1.4fr;
    gap: 3rem;
    padding-bottom: 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .footer-title {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: #fff;
    letter-spacing: 0.06em;
    margin-bottom: 0.9rem;
  }

  .footer-motto {
    color: #d9a05b;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .footer-desc {
    color: rgba(255, 255, 255, 0.55);
    max-width: 26rem;
    font-size: 0.9rem;
    line-height: 1.9;
  }

  .footer-col-title {
    font-size: 0.95rem;
    color: #fff;
    margin-bottom: 1.1rem;
    letter-spacing: 0.06em;
  }

  .footer-nav {
    display: grid;
    gap: 0.65rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-nav a:hover {
    color: #fff;
  }

  .footer-bottom {
    padding-top: 1.75rem;
    text-align: center;
  }

  .copyright {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.25rem;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
