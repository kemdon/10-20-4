---
interface LogoItem {
  name?: string;
  image?: string;
}

interface Props {
  label?: string;
  title?: string;
  logos: LogoItem[];
}

const { label, title, logos } = Astro.props;
const visibleLogos = logos.filter((item) => item.name);
const hasImages = visibleLogos.some((item) => item.image);
---

{visibleLogos.length > 0 && (
  <section class="logo-cloud section-padding">
    <div class="container">
      <div class="logo-cloud-head fade-in-up">
        {label && <span class="section-kicker">{label}</span>}
        {title && <h2 class="logo-cloud-title">{title}</h2>}
      </div>

      <div class="logo-cloud-grid">
        {visibleLogos.map((item, index) => (
          <div class={`logo-pill fade-in-up${item.image ? ' has-image' : ''}`} style={`transition-delay: ${index * 70}ms`}>
            {item.image ? (
              <img src={item.image} alt={item.name || ''} class="logo-img" />
            ) : (
              item.name
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .logo-cloud {
    padding-top: 0;
  }

  .logo-cloud-head {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
    margin-bottom: 2.5rem;
  }

  .section-kicker {
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-primary);
  }

  .logo-cloud-title {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }

  .logo-cloud-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.75rem;
  }

  .logo-pill {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 4.25rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    color: var(--color-text-muted);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-align: center;
    transition: var(--transition-smooth);
  }

  .logo-pill:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .logo-pill.has-image {
    padding: 0.5rem 1rem;
  }

  .logo-img {
    max-height: 2.8rem;
    width: auto;
    object-fit: contain;
  }

  @media (max-width: 900px) {
    .logo-cloud-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .logo-cloud-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .logo-cloud-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
