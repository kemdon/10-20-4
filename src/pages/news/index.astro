---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleConfig, getSiteSettings } from '../../lib/site-content';
import { newsItems } from '../../data/news';

const { defaultLocale } = await getLocaleConfig();
const site = await getSiteSettings(defaultLocale);
---

<Layout
  title="学院新闻"
  description="硕学教育与院校合作、教学表彰等最新动态。"
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage={site.defaultOgImage}
>
  <Navbar site={site} locale={defaultLocale} currentPath="/" />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <span class="kicker">NEWS CENTER</span>
        <h1>学院新闻</h1>
      </div>
    </section>
    <div class="page-body">
      <div class="container">

      <div class="sec-block">
        <ul class="news-list">
            {newsItems.map((item) => (
              <li>
                <a href={`/news/${item.slug}/`}>{item.title}</a>
                <span class="date">{item.date.slice(0, 7)}</span>
                <span class="snippet">{item.summary}</span>
              </li>
            ))}
          </ul>
      </div>
      </div>
    </div>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>
