const majorsBenke = ['会计学', '工商管理', '市场营销', '电子商务', '行政管理', '学前教育', '小学教育', '汉语言文学', '法学', '机械设计制造及其自动化', '电气工程及其自动化', '计算机科学与技术', '土木工程', '工程管理', '护理学', '药学', '金融学', '国际经济与贸易', '人力资源管理', '电子信息工程', '软件工程', '环境设计', '英语', '视觉传达设计'];
const majorsZhuanke = ['大数据与会计', '工商企业管理', '电子商务', '市场营销', '行政管理', '学前教育', '小学教育', '计算机应用技术', '机电一体化技术', '建筑工程技术', '建设工程管理', '护理', '药学', '现代物流管理', '旅游管理', '人力资源管理', '金融服务与管理', '大数据技术', '汽车制造与试验技术', '数控技术', '艺术设计', '商务英语', '法律事务', '财务管理'];

const certs = [
  { image: '/assets/images/cert-real-1.webp', name: '浙江师范大学 · 毕业证书' },
  { image: '/assets/images/cert-real-2.webp', name: '浙江师范大学 · 学位证书' },
  { image: '/assets/images/cert-real-3.webp', name: '宁波大学 · 毕业证书' },
  { image: '/assets/images/cert-real-4.webp', name: '嘉兴大学 · 学位证书' },
  { image: '/assets/images/cert-real-5.webp', name: '丽水职业技术学院 · 毕业证书' },
];

const honors = [
  { image: '/assets/images/honors/real-honor-1.webp', name: '浙江师范大学 · 优秀教学点（2025）' },
  { image: '/assets/images/honors/real-honor-3.webp', name: '浙江国际海运职业技术学院 · 优秀教学点' },
  { image: '/assets/images/honors/real-honor-5.webp', name: '浙江海洋大学 · 优秀函授站' },
  { image: '/assets/images/honors/real-honor-7.webp', name: '浙江工商职业技术学院 · 优秀教学点' },
  { image: '/assets/images/honors/real-honor-8.webp', name: '浙江农林大学 · 合作办学进步单位' },
];

const moments = [
  { image: '/assets/images/moment-real-1.webp', name: '浙师大荣誉教学点授牌' },
  { image: '/assets/images/moment-real-2.webp', name: '名师线下课堂' },
  { image: '/assets/images/moment-real-3.webp', name: '浙师大开学典礼' },
  { image: '/assets/images/moment-real-4.webp', name: '学员植物园踏青' },
  { image: '/assets/images/moment-real-5.webp', name: '浙海洋教学点工作会议' },
];

// 反馈要求：常见问题放在「立即咨询」表单下方
const homeFaqs = [
  { q: '成人高考适合哪些人报读？', a: '面向在职人员和社会其他人员，通过全国统一入学考试后以非脱产方式学习，工作学习两不误，是在职人员提升专科、本科学历的主流通道。' },
  { q: '学历基础较低，还有提升路径吗？', a: '有。可以先从中专或高起专起步，再逐级报读专科、本科，形成完整提升路径；自考本科可先考试，申请毕业时再提交专科证。' },
  { q: '工作繁忙，哪种学习方式更灵活？', a: '国家开放大学以线上网课为主，成考录取后线上学习为主，自考自主学习、只参加统考。三种方式都不需要脱产。' },
  { q: '在职人员可以读研究生吗？', a: '可以。同等学力申硕是在职人员获得硕士学位的正规通道，我们提供院校专业选择、申硕流程规划与备考辅导。' },
  { q: '硕学教育在哪些地方有服务网点？', a: '在宁波拥有 3 家分校、6 个接待点，欢迎到就近校区咨询，也可以先在线提交信息由教务老师联系。' },
  { q: '除了学历提升，还有其他课程吗？', a: '有。自设会计、新媒体运营、办公软件、电商等面授课程，并提供职业技能培训与考证辅导。' },
];
---

<Layout
  title={site.brandName + ' - 提升学历 · 成就更好的你 | 宁波成人学历教育'}
  description={site.defaultMetaDescription}
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage="/assets/images/hero-main.webp"
>
  <Navbar site={site} locale={defaultLocale} currentPath="/" />
  <main id="main" class="lp-main">

    <!-- 主视觉轮播 -->
    <section class="lp-hero" aria-label="招生宣传轮播">
      {heroSlides.map((slide, i) => (
        <div class={`hero-slide${i === 0 ? ' active' : ''}`} data-slide={i}>
          <img src={slide.image} alt="" aria-hidden="true" />
          <div class="hero-veil"></div>
          <div class="container hero-inner">
            <h1 class="hero-title">{slide.title}</h1>
            <p class="hero-subtitle"><span></span>{slide.subtitle}<span></span></p>
            <a class="hero-btn" href={slide.href}>{slide.cta} <b>›</b></a>
          </div>
        </div>
      ))}
      <button class="hero-arrow prev" type="button" data-hero-prev aria-label="上一张">‹</button>
      <button class="hero-arrow next" type="button" data-hero-next aria-label="下一张">›</button>
      <div class="hero-dots" role="tablist" aria-label="轮播导航">
        {heroSlides.map((_, i) => (
          <button class={`hero-dot${i === 0 ? ' active' : ''}`} data-hero-dot={i} aria-label={`第 ${i + 1} 张`}></button>
        ))}
      </div>
    </section>

    <!-- 新闻资讯 + 招生简章 / 二维码 -->
    <section class="lp-news-wrap">
      <div class="container lp-news-grid">
        <article class="news-card">
          <header class="card-head">
            <h2>新闻资讯</h2>
            <a href="/news/">更多 ›</a>
          </header>
          <div class="news-card-body">
            <div class="news-thumb" data-news-carousel>
              <a class="news-thumb-link active" href="/news/"><img src="/assets/images/banner-1.webp" alt="校园秋景 · 新闻资讯" loading="lazy" /></a>
              <a class="news-thumb-link" href="/news/"><img src="/assets/images/moment-real-3.webp" alt="浙师大开学典礼" loading="lazy" /></a>
              <a class="news-thumb-link" href="/news/"><img src="/assets/images/moment-real-1.webp" alt="荣誉教学点授牌" loading="lazy" /></a>
              <span class="news-thumb-dots" aria-hidden="true"><i class="active"></i><i></i><i></i></span>
            </div>
            <ul class="news-lines">
              {news.map((item) => (
                <li><a href={item.href}>{item.title}</a><span>{item.date}</span></li>
              ))}
            </ul>
          </div>
        </article>

        <article class="news-card">
          <header class="card-head">
            <h2>招生简章</h2>
            <a href="/universities/">更多 ›</a>
          </header>
          <div class="news-card-body guide-body">
            <ul class="news-lines">
              {guides.map((item) => (
                <li><a href={item.href}>{item.title}</a><span>2026</span></li>
              ))}
            </ul>
            <div class="qr-box">
              <img src="/assets/images/qr-signup.svg" alt="扫码进入在线报名页的二维码" loading="lazy" />
              <p>扫码在线报名</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <!-- 热门招生项目 -->
    <section class="lp-section lp-programs">
      <div class="container">
        <div class="sec-head">
          <h2>热门招生项目</h2>
          <span>HOT PROGRAMS</span>
          <i></i>
        </div>
        <div class="program-grid">
          <a class="program-card" href="/products/chengkao/">
            <span class="program-icon">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 24 8l20 9-20 9L4 17Z"/><path d="M12 21v10c0 3 5.4 5 12 5s12-2 12-5V21"/><path d="M44 17v12"/><circle cx="44" cy="32" r="1.6" fill="currentColor" stroke="none"/></svg>
            </span>
            <h3>成人高考</h3>
            <p>省内多所公办高校官方函授站，报考、考前辅导、教务管理一体化服务。</p>
          </a>
          <a class="program-card" href="/products/zikao/">
            <span class="program-icon">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M24 12c-4-3-10-4-17-3v26c7-1 13 0 17 3 4-3 10-4 17-3V9c-7-1-13 0-17 3Z"/><path d="M24 12v26"/></svg>
            </span>
            <h3>自学考试</h3>
            <p>自学考试助学与考务支持，灵活安排学习节奏，适合在职人员提升学历。</p>
          </a>
          <a class="program-card" href="/products/guokai/">
            <span class="program-icon">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="24" cy="24" r="17"/><path d="M7 24h34"/><path d="M24 7c5 5 7 11 7 17s-2 12-7 17c-5-5-7-11-7-17s2-12 7-17Z"/></svg>
            </span>
            <h3>国家开放大学</h3>
            <p>春、秋两季注册，线上学习为主，工作与学习兼顾，学籍学历国家承认。</p>
          </a>
          <a class="program-card" href="/training/">
            <span class="program-icon">
              <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5h18l7 7v31H12V5Z"/><path d="M30 5v8h7"/><path d="M18 22h13M18 29h13M18 36h9"/></svg>
            </span>
            <h3>职业技能培训</h3>
            <p>考证辅导、办公软件与电商运营等面授课程，并提供企业定制化内训。</p>
          </a>
        </div>
      </div>
    </section>

    <!-- 招生院校 -->
    <section class="lp-section lp-universities">
      <div class="container">
        <div class="sec-head">
          <h2>招生院校</h2>
          <span>PARTNER UNIVERSITIES</span>
          <i></i>
        </div>
        <div class="uni-grid">
          {universities.map((u) => (
            <a class="uni-card" href="/universities/">
              <img src={u.image} alt={`${u.name}院校标识占位图`} loading="lazy" />
              <span>{u.name}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 合作高校标识墙 -->
    <section class="lp-section lp-partners">
      <div class="container">
        <div class="partners-grid">
          {partners.map((name, i) => (
            <div class="partner-card">
              <span class={`partner-seal seal-${i % 4}`} aria-hidden="true">{(name || '').slice(0, 1)}</span>
              <span class="partner-name">{name}</span>
            </div>
          ))}
        </div>
        <p class="partners-note">20+ 合作高校 · 官方函授站与教学点</p>
      </div>
    </section>

    <!-- 招生专业 -->
    <section class="lp-section lp-majors">
      <div class="container">
        <div class="sec-head">
          <h2>招生专业</h2>
          <span>MAJORS &amp; PROGRAMS</span>
          <i></i>
        </div>
        <div class="major-grid">
          <article class="major-card">
            <header>
              <span class="major-cap">
                <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M2 11 16 4l14 7-14 7L2 11Z"/><path d="M7 14v7c0 2.6 4 4.5 9 4.5s9-1.9 9-4.5v-7l-9 4.3L7 14Z"/></svg>
              </span>
              <h3>本科</h3>
              <a href="/majors/">查看全部 ›</a>
            </header>
            <ul class="major-list">
              {majorsBenke.map((m) => <li><a href="/majors/">{m}</a></li>)}
            </ul>
          </article>
          <article class="major-card">
            <header>
              <span class="major-cap">
                <svg viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M2 11 16 4l14 7-14 7L2 11Z"/><path d="M7 14v7c0 2.6 4 4.5 9 4.5s9-1.9 9-4.5v-7l-9 4.3L7 14Z"/></svg>
              </span>
              <h3>专科</h3>
              <a href="/majors/">查看全部 ›</a>
            </header>
            <ul class="major-list">
              {majorsZhuanke.map((m) => <li><a href="/majors/">{m}</a></li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <!-- 证书样本 -->
    <section class="lp-section lp-carousel-section">
      <div class="container">
        <div class="sec-head">
          <h2>证书样本</h2>
          <span>CERTIFICATE SAMPLES</span>
          <i></i>
        </div>
        <div class="carousel">
          <button class="carousel-arrow prev" type="button" data-carousel-prev aria-label="向左滚动">‹</button>
          <div class="carousel-track" data-carousel-track>
            {certs.map((c) => (
              <figure class="cert-item">
                <img src={c.image} alt={c.name} loading="lazy" />
                <figcaption>{c.name}</figcaption>
              </figure>
            ))}
          </div>
          <button class="carousel-arrow next" type="button" data-carousel-next aria-label="向右滚动">›</button>
        </div>
        <p class="disclaimer">以上为合作高校真实毕业证 / 学位证样本（已作缩略展示），实际证书以各高校正式颁发、学信网可查为准。</p>
      </div>
    </section>

    <!-- 荣誉展示 -->
    <section class="lp-section lp-honors">
      <div class="container">
        <div class="sec-head">
          <h2>荣誉展示</h2>
          <span>HONORS &amp; RECOGNITION</span>
          <i></i>
        </div>
        <div class="honor-grid">
          {honors.map((h) => (
            <figure class="honor-item">
              <img src={h.image} alt={h.name} loading="lazy" />
              <figcaption>{h.name}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>

    <!-- 精彩回顾 -->
    <section class="lp-section lp-carousel-section lp-moments">
      <div class="container">
        <div class="sec-head">
          <h2>精彩回顾</h2>
          <span>CAMPUS MOMENTS</span>
          <i></i>
        </div>
        <div class="carousel">
          <button class="carousel-arrow prev" type="button" data-carousel-prev aria-label="向左滚动">‹</button>
          <div class="carousel-track" data-carousel-track>
            {moments.map((m) => (
              <figure class="moment-item">
                <img src={m.image} alt={m.name} loading="lazy" />
                <figcaption>{m.name}</figcaption>
              </figure>
            ))}
          </div>
          <button class="carousel-arrow next" type="button" data-carousel-next aria-label="向右滚动">›</button>
        </div>
      </div>
    </section>

    <!-- 报名引导 -->
    <section class="lp-lead">
      <div class="container">
        <div class="sec-head">
          <h2>还在纠结学历怎么提升？</h2>
          <span>FREE CONSULTATION</span>
          <i></i>
        </div>
        <p class="lead-sub">留下你的信息，教务老师为你做一次免费的学历规划与院校专业匹配。</p>
        <form class="lead-form" action="/signup/" method="get">
          <label class="sr-only" for="lead-name">您的姓名</label>
          <input id="lead-name" name="name" type="text" placeholder="您的姓名" autocomplete="name" />
          <label class="sr-only" for="lead-phone">手机号码</label>
          <input id="lead-phone" name="phone" type="tel" placeholder="手机号码" autocomplete="tel" inputmode="tel" pattern="[0-9+\-\s]{7,20}" />
          <label class="sr-only" for="lead-level">意向层次</label>
          <select id="lead-level" name="level">
            <option value="">意向层次</option>
            <option value="专科">专科</option>
            <option value="本科">本科</option>
            <option value="在职研究生">在职研究生</option>
            <option value="职业培训">职业技能培训</option>
          </select>
          <button type="submit">立即咨询</button>
        </form>
        <p class="lead-note">提交后前往在线报名页 · 信息仅用于本次咨询，不会对外公开</p>

        <div class="faq-inline">
          <h3>常见问题</h3>
          {homeFaqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
          <p class="faq-inline-more"><a href="/faq/">查看全部常见问题 ›</a></p>
        </div>
      </div>
    </section>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>

<script>
  // 新闻缩略图轮播（反馈：这张图为轮播图）
  const thumbCarousel = document.querySelector('[data-news-carousel]');
  if (thumbCarousel) {
    const thumbLinks = [...thumbCarousel.querySelectorAll('.news-thumb-link')];
    const thumbDots = [...thumbCarousel.querySelectorAll('.news-thumb-dots i')];
    let thumbIndex = 0;
    const showThumb = (i) => {
      thumbIndex = (i + thumbLinks.length) % thumbLinks.length;
      thumbLinks.forEach((el, n) => el.classList.toggle('active', n === thumbIndex));
      thumbDots.forEach((el, n) => el.classList.toggle('active', n === thumbIndex));
    };
    thumbDots.forEach((dot, n) => dot.addEventListener('click', () => showThumb(n)));
    setInterval(() => showThumb(thumbIndex + 1), 4500);
  }

  // 主视觉轮播
  const slides = [...document.querySelectorAll('.hero-slide')];
  const dots = [...document.querySelectorAll('.hero-dot')];
  let current = 0;
  let timer;
  const show = (i) => {
    const next = (i + slides.length) % slides.length;
    slides.forEach((s, idx) => s.classList.toggle('active', idx === next));
    dots.forEach((d, idx) => d.classList.toggle('active', idx === next));
    current = next;
  };
  const restart = () => {
    clearInterval(timer);
    timer = setInterval(() => show(current + 1), 6000);
  };
  document.querySelector('[data-hero-prev]')?.addEventListener('click', () => { show(current - 1); restart(); });
  document.querySelector('[data-hero-next]')?.addEventListener('click', () => { show(current + 1); restart(); });
  dots.forEach((d) => d.addEventListener('click', () => { show(Number(d.getAttribute('data-hero-dot'))); restart(); }));
  if (slides.length > 1) restart();

  // 图片轮播（横向滚动）
  document.querySelectorAll('.carousel').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    if (!track) return;
    const step = () => Math.max(240, track.clientWidth * 0.6);
    carousel.querySelector('[data-carousel-prev]')?.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    carousel.querySelector('[data-carousel-next]')?.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  });
</script>

