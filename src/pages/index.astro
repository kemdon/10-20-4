const guides = [
  { title: '2026 年浙江海洋大学成人高等教育招生简章', href: '/universities/' },
  { title: '2026 年浙江师范大学成人高等教育招生简章', href: '/universities/' },
  { title: '2026 年金华职业技术大学招生简章', href: '/universities/' },
  { title: '国家开放大学春秋两季注册说明', href: '/products/guokai/' },
];

const universities = [
  { image: '/assets/images/uni-01.webp', name: '浙江海洋大学' },
  { image: '/assets/images/uni-02.webp', name: '浙江师范大学' },
  { image: '/assets/images/uni-03.webp', name: '金华职业技术大学' },
  { image: '/assets/images/uni-04.webp', name: '浙江工商职业技术学院' },
  { image: '/assets/images/uni-05.webp', name: '浙江国际海运职业技术学院' },
  { image: '/assets/images/uni-06.webp', name: '宁波工程学院' },
];

const partners = [
  '浙江师范大学', '浙江海洋大学', '金华职业技术大学', '浙江工商职业技术学院',
  '浙江农林大学', '杭州师范大学', '宁波大学', '湖北师范大学',
  '浙江工商大学', '宁波工程学院', '浙江财经大学', '浙江国际海运职业技术学院',
