---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleConfig, getSiteSettings } from '../../lib/site-content';
import { servicePromise } from '../../data/contacts';

const { defaultLocale } = await getLocaleConfig();
const site = await getSiteSettings(defaultLocale);

// 反馈：证书种类按《考证.docx》补齐，卡片可点开查看证书介绍
const certificates = [
  { name: '健康管理师', group: '健康服务', desc: '原人社部三级职业技能证书，现由第三方评价组织认定；面向体检中心、社区卫生、养老机构、企业医务室，宁波补贴约 2000 元/人。' },
  { name: '公共营养师', group: '健康服务', desc: '宁波职业技能等级认定工种之一，分四级 / 三级 / 二级；可考后申请技能提升补贴，就业面向食堂、幼教机构、健康管理公司与膳食设计岗位（含中国营养学会公共营养师）。' },
  { name: '企业人力资源管理师', group: '企业管理', desc: '宁波职业技能等级认定热门工种，分四级到一级；持证可申请技能补贴，面向中小企业 HR、人事代理、劳务派遣公司，是刚需岗位证书。' },
  { name: '劳动关系协调员', group: '企业管理', desc: '面向企业 HR、工会、仲裁院辅助岗位；处理劳动合同、社保、工伤、劳动争议，宁波制造业密集，需求稳定。' },
  { name: '婚姻家庭辅导师', group: '生活服务', desc: '面向民政婚姻登记处辅导岗、妇联社工机构、青少年心理咨询；多为专项能力证书，适合社工、教师、心理咨询师跨界。' },
  { name: '婴幼儿发展引导员（育婴员）', group: '生活服务', desc: '宁波紧缺工种之一，可领政府补贴；面向托育机构、早教中心、亲子园，覆盖 0-3 岁照护与早期发展指导。' },
  { name: '保育师', group: '生活服务', desc: '面向幼儿园、托育机构的保育岗位，课程涵盖幼儿生活照护、卫生消毒、常见意外处理与配合教育活动，适合幼教从业人员持证上岗。' },
  { name: '养老护理员', group: '健康服务', desc: '宁波高补贴、高缺口工种，分五级到一级；面向养老院、居家照护、社区日间照料中心，高级工补贴可达 2000 元以上。' },
  { name: '低压电工', group: '特种作业', desc: '特种作业操作证（应急管理部颁发），上岗必备；低压工适用面广，宁波制造业招聘常年开放。' },
  { name: '高压电工', group: '特种作业', desc: '特种作业操作证，面向变电站、物业工程岗与工厂配电运维，需具备相应安全作业培训与实操考核。' },
  { name: '焊工', group: '特种作业', desc: '熔化焊接与热切割作业操作证，面向造船、钢结构、压力容器、新能源电池产线；宁波港口装备和汽车零部件产业需求大，属高薪紧缺工种。' },
  { name: '心理咨询师', group: '心理服务', desc: '宁波目前主要考「心理咨询师基础培训」（中科院心理所颁证），面向医院心理科、学校、社区 EAP、心理咨询机构；持证是机构招聘和收费服务的前提。' },
  { name: '陪诊师', group: '生活服务', desc: '属新职业能力证书，由行业协会或培训评价组织颁证；面向医院陪同就诊、代办取药、异地就医家属陪同等，宁波各大三甲医院周边需求旺盛。' },
  { name: '体重管理师', group: '健康服务', desc: '面向健身机构、体检中心、月子中心、减脂工作室；证书以行业培训为主，配合营养师 / 健康管理师组合执业效果更好。' },
  { name: '中医健康管理技术', group: '健康服务', desc: '面向中医馆、康养机构、社区卫生服务中心；培训含体质辨识、经络调理、艾灸拔罐实操，适合有中医背景或养生行业从业者。' },
  { name: '家庭教育指导', group: '教育服务', desc: '由人社部「家庭教育指导师」专项能力证书主导；面向学校家委会、社区家长学校、青少年辅导机构，宁波多区教育局每年采购相关服务。' },
  { name: '家庭健康顾问', group: '健康服务', desc: '偏高端健康管家方向，面向家庭医生助理、社区健康驿站、私人体检客户跟进；多为机构内训 + 结业证书，与健康管理师组合更具竞争力。' },
  { name: '心理教练', group: '心理服务', desc: '以积极心理学 / 教练技术为核心，面向企业 EAP、青少年成长、职业规划；证书多由国际教练机构或行业协会颁发，适合已具备心理咨询基础的人员进阶。' },
];
---

<Layout
  title="硕学一站式职业技能培训中心"
  description="专业培训 · 正规报考 · 全程辅导 · 轻松拿证。健康管理师、公共营养师、人力资源管理师、电工焊工、心理咨询师等职业证书辅导，另开设同等学力申硕在职研究生项目。"
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage={site.defaultOgImage}
>
  <Navbar site={site} locale={defaultLocale} currentPath="/training" />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <span class="kicker">TRAINING CENTER</span>
        <h1>硕学一站式职业技能培训中心</h1>
        <p class="hero-sub">专业培训 · 正规报考 · 全程辅导 · 轻松拿证</p>
        <span class="hero-rule"></span>
      </div>
    </section>

    <div class="page-body">
      <div class="container training-container">
        <div class="training-layout">
          <div class="training-main">
            <div class="sec-block">
              <h2 class="sec-title">教学服务</h2>
              <p class="service-lead">{servicePromise}</p>
              <p class="service-note">硕学教育提供报考条件评估、报名材料整理、考前串讲与模拟训练、考后证书领取跟进，学员全程有教务老师对接。</p>
            </div>

            <div class="sec-block">
              <h2 class="sec-title">证书种类 · {certificates.length} 项</h2>
              <p class="cert-hint">点击证书卡片，查看适用方向、颁证形式与就业场景。</p>
              <div class="cert-card-grid" id="cert-grid">
                {certificates.map((c, i) => (
                  <button type="button" class="cert-card" data-cert-index={i} aria-pressed="false">
                    <span class="cert-name">{c.name}</span>
                    <span class="cert-group">{c.group}</span>
                  </button>
                ))}
              </div>
              <div class="cert-detail" id="cert-detail" hidden>
                <span class="cert-detail-tag" id="cert-detail-tag">健康服务</span>
                <h3 id="cert-detail-name">健康管理师</h3>
                <p id="cert-detail-desc"></p>
                <p class="cert-detail-tip">证书名称、报考条件、认定机构与补贴政策以当年人社部门及评价组织公布为准，报名前请先做条件预审。</p>
                <a class="major-cta" id="cert-consult" href="/signup/?project=%E8%81%8C%E4%B8%9A%E6%8A%80%E8%83%BD%E5%9F%B9%E8%AE%AD">咨询这个证书 →</a>
              </div>
            </div>

            <!-- 反馈：自设面授课放到下面 -->
            <div class="sec-block">
              <h2 class="sec-title">自设面授课程</h2>
              <div class="tile-grid">
                <div class="tile">会计面授课</div>
                <div class="tile">新媒体运营面授课</div>
                <div class="tile">办公软件面授课</div>
                <div class="tile">硕学电商面授课</div>
              </div>
              <p class="disclaimer">以上为硕学自设的面授课程，在宁波各分校滚动开班，具体课表与开班时间请到就近分校咨询。</p>
            </div>

            <div class="sec-block">
              <h2 class="sec-title">企业内训</h2>
              <div class="major-cols">
                <div class="info-card">
                  <h3>定制课程</h3>
                  <p class="card-text">办公软件、口头表达、目标管理、协作与谈判、财务报表分析等模块，按岗位能力模型自由组合。</p>
                </div>
                <div class="info-card">
                  <h3>服务流程</h3>
                  <p class="card-text">需求调研 → 方案设计 → 讲师匹配 → 课程实施 → 效果评估，可为企事业单位提供上门或到校培训。</p>
                </div>
              </div>
            </div>
          </div>

          <!-- 反馈：职业培训右侧加一栏 在职研究生 -->
          <aside class="training-aside">
            <div class="aside-card">
              <span class="aside-kicker">IN-SERVICE GRADUATE</span>
              <h2>在职研究生</h2>
              <p class="aside-sub">浙江师范大学 2027 年同等学力申请硕士学位</p>
              <ul class="aside-list">
                <li>免试入学，入学门槛低</li>
                <li>线上网课 + 周末面授，不脱产</li>
                <li>15 个学科招生，覆盖教育、文学、理学等</li>
                <li>统考通过后修课程、写论文，申请硕士学位</li>
                <li>总费用 4.5 万元，开课前一次性缴纳</li>
              </ul>
              <a class="aside-cta" href="/graduate/">查看项目详情 →</a>
              <a class="aside-cta ghost" href="/signup/?project=%E5%90%8C%E7%AD%89%E5%AD%A6%E5%8A%9B%E7%94%B3%E7%A1%95">咨询这个项目</a>
              <p class="aside-note">完成全部流程仅获得硕士学位证（单证），无研究生学历证；学位与全日制硕士学位具备同等法律效力。</p>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>

<style>
  .training-container { max-width: 1200px; }
  .training-layout { display: grid; grid-template-columns: minmax(0, 1fr) 20rem; gap: 2rem; align-items: start; }
  .training-main { min-width: 0; }
  .sec-block { margin-bottom: 2.4rem; }
  .hero-sub { font-size: 0.88rem !important; letter-spacing: 0.14em; }
  .service-lead {
    padding: 1rem 1.2rem; background: #FBF6EC; border: 1px solid #EBD9B4; border-radius: 0.6rem;
    color: #7A5B18; font-size: 0.95rem; line-height: 1.95;
  }
  .service-note, .card-text { margin-top: 0.8rem; color: var(--color-text-muted); font-size: 0.9rem; line-height: 1.9; }
  .cert-hint { margin: -0.6rem 0 1rem; font-size: 0.88rem; color: var(--color-text-muted); }
  /* 反馈「证书卡片参考」：白色圆角卡片，三列网格 */
  .cert-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.8rem; }
  .cert-card {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.4rem;
    min-height: 5.4rem; padding: 0.9rem 0.6rem;
    background: #fff; border: 1px solid #EDF1F7; border-radius: 0.7rem;
    box-shadow: 0 4px 14px rgba(23, 63, 116, 0.06);
    font-family: inherit; text-align: center; cursor: pointer; transition: all 0.22s ease;
  }
  .cert-card:hover { transform: translateY(-3px); border-color: var(--color-primary); box-shadow: 0 10px 24px rgba(23, 63, 116, 0.13); }
  .cert-card[aria-pressed="true"] { border-color: var(--color-primary); background: #F2F7FF; }
  .cert-name { font-size: 0.92rem; font-weight: 600; color: #1B3E6D; line-height: 1.5; }
  .cert-group { font-size: 0.72rem; color: #9AA7B8; }
  .cert-detail {
    margin-top: 1.2rem; padding: 1.3rem 1.5rem; background: #F7FAFE;
    border: 1px solid #E4ECF6; border-left: 4px solid var(--color-primary); border-radius: 0.7rem;
  }
  .cert-detail[hidden] { display: none; }
  .cert-detail-tag { display: inline-block; padding: 0.2rem 0.75rem; border-radius: 999px; background: var(--color-primary-soft); color: var(--color-primary); font-size: 0.74rem; font-weight: 600; }
  .cert-detail h3 { margin: 0.7rem 0 0.5rem; font-size: 1.2rem; color: #16437D; }
  .cert-detail p { color: #46586E; font-size: 0.9rem; line-height: 1.9; }
  .cert-detail-tip { margin-top: 0.7rem; font-size: 0.8rem !important; color: #8794A6 !important; }
  .major-cta { display: inline-block; margin-top: 0.8rem; padding: 0.55rem 1.3rem; border-radius: 999px; background: #1D4E89; color: #fff; font-size: 0.85rem; text-decoration: none; }
  .major-cta:hover { background: #16437D; }
  .training-aside { position: sticky; top: 7rem; }
  .aside-card {
    padding: 1.6rem 1.4rem; border-radius: 0.85rem;
    background: linear-gradient(160deg, #12386C 0%, #1B4F94 100%); color: #fff;
    box-shadow: 0 12px 32px rgba(18, 56, 108, 0.2);
  }
  .aside-kicker { font-size: 0.66rem; letter-spacing: 0.2em; color: #F0CE8C; }
  .aside-card h2 { margin: 0.5rem 0 0.35rem; font-size: 1.5rem; letter-spacing: 0.04em; }
  .aside-sub { font-size: 0.82rem; color: rgba(226, 238, 255, 0.82); line-height: 1.7; }
  .aside-list { margin: 1.1rem 0 1.3rem; padding-left: 1.1rem; display: grid; gap: 0.55rem; }
  .aside-list li { font-size: 0.84rem; line-height: 1.7; color: rgba(235, 244, 255, 0.92); }
  .aside-cta { display: block; margin-top: 0.6rem; padding: 0.65rem 1rem; border-radius: 999px; background: #F0CE8C; color: #12386C; font-size: 0.88rem; font-weight: 700; text-align: center; text-decoration: none; }
  .aside-cta:hover { filter: brightness(1.06); }
  .aside-cta.ghost { background: transparent; border: 1px solid rgba(255, 255, 255, 0.55); color: #fff; }
  .aside-note { margin-top: 1rem; font-size: 0.74rem; line-height: 1.75; color: rgba(226, 238, 255, 0.7); }
  @media (max-width: 900px) {
    .training-layout { grid-template-columns: 1fr; }
    .training-aside { position: static; }
    .cert-card-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 480px) {
    .cert-card-grid { grid-template-columns: 1fr 1fr; gap: 0.55rem; }
    .cert-name { font-size: 0.82rem; }
  }
</style>

<script define:vars={{ certificates }}>
  const cards = [...document.querySelectorAll('[data-cert-index]')];
  const detail = document.getElementById('cert-detail');
  const tag = document.getElementById('cert-detail-tag');
  const name = document.getElementById('cert-detail-name');
  const desc = document.getElementById('cert-detail-desc');
  const consult = document.getElementById('cert-consult');
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const c = certificates[Number(card.dataset.certIndex)];
      if (!c) return;
      cards.forEach((x) => x.setAttribute('aria-pressed', String(x === card)));
      tag.textContent = c.group;
      name.textContent = c.name;
      desc.textContent = c.desc;
      consult.href = `/signup/?project=${encodeURIComponent(c.name)}`;
      detail.hidden = false;
      detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  });
</script>
