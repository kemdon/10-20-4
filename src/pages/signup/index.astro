---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleConfig, getSiteSettings } from '../../lib/site-content';

const { defaultLocale } = await getLocaleConfig();
const site = await getSiteSettings(defaultLocale);
---

<Layout
  title="在线报名"
  description="四步完成报名咨询，欢迎到就近分校或接待点办理。"
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage={site.defaultOgImage}
>
  <Navbar site={site} locale={defaultLocale} currentPath="/" />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <span class="kicker">SIGN UP</span>
        <h1>在线报名</h1>
      </div>
    </section>
    <div class="page-body">
      <div class="container">

      <div class="sec-block">
        <h2 class="sec-title">报名流程</h2>
        <div class="step-grid">
          <div class="step-card"><div class="no">01</div><h3>咨询规划</h3><p>到就近分校或接待点，老师根据你的学历基础与职业目标推荐合适的院校与专业。</p></div>
          <div class="step-card"><div class="no">02</div><h3>准备材料</h3><p>身份证、前置学历证书、证件照等报名材料，教务老师协助整理与审核。</p></div>
          <div class="step-card"><div class="no">03</div><h3>网上报名</h3><p>在规定时间内完成教育考试院统一报名或高校注册，并完成考前辅导报名。</p></div>
          <div class="step-card"><div class="no">04</div><h3>入学学习</h3><p>录取后由教务老师跟进学籍注册与课程安排，直至顺利毕业。</p></div>
        </div>
      </div>
      <div class="page-body alt">
        <div class="container">
          <h2 class="sec-title">在线咨询登记</h2>
          <div class="info-card">
            <form class="signup-form" id="signup-form" novalidate>
              <div class="signup-row">
                <label class="sr-only" for="sf-name">您的姓名</label>
                <input id="sf-name" name="name" type="text" placeholder="您的姓名 *" autocomplete="name" required />
                <label class="sr-only" for="sf-phone">手机号码</label>
                <input id="sf-phone" name="phone" type="tel" placeholder="手机号码 *" autocomplete="tel" inputmode="tel" pattern="[0-9+\-\s]{7,20}" required />
                <label class="sr-only" for="sf-level">意向层次</label>
                <select id="sf-level" name="level">
                  <option value="">意向层次</option>
                  <option value="专科">专科</option>
                  <option value="本科">本科</option>
                  <option value="在职研究生">在职研究生</option>
                  <option value="职业技能培训">职业技能培训</option>
                </select>
                <button type="submit">提交登记</button>
              </div>
              <p class="signup-note" id="sf-note">提交后教务老师将尽快与你联系 · 信息仅用于本次咨询</p>
            </form>
          </div>
        </div>
      </div>
      <div class="page-body">
        <div class="container">
          <h2 class="sec-title">报名方式</h2>
          <div class="major-cols">
            <div class="info-card">
              <h3>到校咨询报名</h3>
              <p style="margin-top:0.75rem;color:var(--color-text-muted);line-height:1.9;font-size:0.93rem">宁波市区 3 家分校、6 个接待点均可现场咨询与办理报名，建议先到校做免费学历规划。</p>
              <a class="portal-more" href="/contact">查看校区分布 »</a>
            </div>
            <div class="info-card">
              <h3>报名提醒</h3>
              <p style="margin-top:0.75rem;color:var(--color-text-muted);line-height:1.9;font-size:0.93rem">成人高考报名时间集中、考位有限，建议提前准备材料；报名政策以浙江省教育考试院当年公布为准。</p>
              <a class="portal-more" href="/notices">查看教务通知 »</a>
            </div>
          </div>
        </div>
      </div>
      </div>
    </div>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>

<style>
  .signup-form { display: grid; gap: 0.7rem; }
  .signup-row { display: grid; grid-template-columns: 1fr 1fr 1fr auto; gap: 0.9rem; }
  .signup-form input, .signup-form select, .signup-form button {
    height: 2.9rem; border-radius: 999px; font-size: 0.9rem; font-family: inherit;
  }
  .signup-form input, .signup-form select {
    padding: 0 1.1rem; border: 1px solid var(--color-border); background: #fff; color: var(--color-text); outline: none;
  }
  .signup-form input:focus, .signup-form select:focus { border-color: var(--color-primary); box-shadow: 0 0 0 3px rgba(29, 78, 137, 0.12); }
  .signup-form button {
    padding: 0 2rem; border: none; background: var(--color-primary); color: #fff; font-weight: 600; cursor: pointer;
  }
  .signup-form button:hover { background: var(--color-primary-dark); }
  .signup-form button:disabled { opacity: 0.6; cursor: wait; }
  .signup-note { font-size: 0.8rem; color: var(--color-text-muted); }
  @media (max-width: 760px) {
    .signup-row { grid-template-columns: 1fr; }
    .signup-form button { width: 100%; }
  }
</style>

<script>
  const form = document.getElementById('signup-form');
  if (form) {
    const note = document.getElementById('sf-note');
    const button = form.querySelector('button[type="submit"]');
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const name = document.getElementById('sf-name').value.trim();
      const phone = document.getElementById('sf-phone').value.trim();
      const level = document.getElementById('sf-level').value;
      if (!name || !phone) {
        note.textContent = '请填写姓名和手机号码。';
        note.style.color = '#C8452B';
        return;
      }
      button.disabled = true;
      button.textContent = '提交中…';
      note.style.color = '';
      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, level }),
        });
        const payload = await response.json().catch(() => ({}));
        if (response.ok && payload.ok) {
          note.textContent = '提交成功！教务老师会尽快与你联系。';
          note.style.color = '#2E7B57';
          form.reset();
        } else {
          note.textContent = payload.error || '提交失败，请稍后再试或到校咨询。';
          note.style.color = '#C8452B';
        }
      } catch {
        note.textContent = '网络异常，提交失败，请稍后再试或到校咨询。';
        note.style.color = '#C8452B';
      } finally {
        button.disabled = false;
        button.textContent = '提交登记';
      }
    });
  }
</script>
