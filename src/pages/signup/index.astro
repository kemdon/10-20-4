---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import { getLocaleConfig, getSiteSettings } from '../../lib/site-content';
import { districtContacts } from '../../data/contacts';

const { defaultLocale } = await getLocaleConfig();
const site = await getSiteSettings(defaultLocale);
---

<Layout
  title="在线报名"
  description="在线填写报名意向，宁波各区负责老师为你做免费学历规划与院校专业匹配。"
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage={site.defaultOgImage}
>
  <Navbar site={site} locale={defaultLocale} currentPath="/signup" />
  <main id="main">
    <section class="page-hero">
      <div class="container">
        <span class="kicker">SIGN UP</span>
        <h1>在线报名</h1>
        <p>填写报名意向，教务老师为你做一次免费的学历规划与院校专业匹配</p>
        <span class="hero-rule"></span>
      </div>
    </section>
    <div class="page-body">
      <div class="container signup-container">

        <div class="sec-block">
          <h2 class="sec-title">报名流程</h2>
          <div class="step-grid">
            <div class="step-card"><div class="no">01</div><h3>咨询规划</h3><p>到就近分校或接待点，老师根据你的学历基础与职业目标推荐合适的院校与专业。</p></div>
            <div class="step-card"><div class="no">02</div><h3>准备材料</h3><p>身份证、前置学历证书、证件照等报名材料，教务老师协助整理与审核。</p></div>
            <div class="step-card"><div class="no">03</div><h3>网上报名</h3><p>在规定时间内完成教育考试院统一报名或高校注册，并完成考前辅导报名。</p></div>
            <div class="step-card"><div class="no">04</div><h3>入学学习</h3><p>录取后由教务老师跟进学籍注册与课程安排，直至顺利毕业。</p></div>
          </div>
        </div>

        <!-- 反馈七：挂表单（参考网上报名表单 + 二维码） -->
        <div class="sec-block">
          <h2 class="sec-title">网上报名</h2>
          <div class="signup-layout">
            <aside class="signup-qr">
              <img src="/assets/images/qr-signup.svg" alt="硕学教育在线报名二维码" width="150" height="150" loading="lazy" />
              <h3>扫码或填写表单</h3>
              <p>本页为静态引导式报名：填写后可一键复制报名信息，并直接联系所在区域负责老师，信息不会上传到服务器。</p>
              <a class="qr-link" href="/contact/">查看各区报名联系人 »</a>
            </aside>

            <div class="signup-form-wrap">
              <form id="signup-form" class="signup-form" novalidate>
                <div class="form-row">
                  <label for="su-name">姓名 <em>*</em></label>
                  <input id="su-name" name="name" type="text" autocomplete="name" placeholder="请输入您的姓名" required />
                </div>
                <div class="form-row">
                  <label for="su-phone">手机号码 <em>*</em></label>
                  <input id="su-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder="请输入手机号码" pattern="[0-9+\-\s]{7,20}" required />
                </div>
                <div class="form-row">
                  <label for="su-education">最高学历</label>
                  <select id="su-education" name="education">
                    <option value="">请选择</option>
                    <option value="初中">初中</option>
                    <option value="高中 / 中专">高中 / 中专</option>
                    <option value="大专">大专</option>
                    <option value="本科">本科</option>
                    <option value="本科以上">本科以上</option>
                  </select>
                </div>
                <div class="form-row">
                  <label for="su-level">意向层次</label>
                  <select id="su-level" name="level">
                    <option value="">请选择</option>
                    <option value="专科">专科</option>
                    <option value="本科">本科</option>
                    <option value="在职研究生">在职研究生 / 同等学力申硕</option>
                    <option value="职业技能培训">职业技能培训 / 考证</option>
                  </select>
                </div>
                <div class="form-row">
                  <label for="su-major">意向院校 / 专业 / 项目</label>
                  <input id="su-major" name="major" type="text" placeholder="如：浙江师范大学 · 学前教育" />
                </div>
                <div class="form-row">
                  <label for="su-district">所在区域</label>
                  <select id="su-district" name="district">
                    <option value="">请选择所在区域</option>
                    {districtContacts.map((c) => <option value={c.district}>{c.district}</option>)}
                  </select>
                </div>
                <div class="form-row full">
                  <label for="su-note">补充说明</label>
                  <textarea id="su-note" name="note" rows="3" placeholder="想了解的问题、方便联系的时间等（选填）"></textarea>
                </div>
                <div class="form-actions">
                  <button type="submit" class="submit-btn">提交报名意向</button>
                  <span class="form-note">提交后在本页生成报名信息，可直接复制或拨打电话联系老师</span>
                </div>
              </form>

              <div class="signup-result" id="signup-result" hidden>
                <h3>报名信息已生成</h3>
                <p class="result-text">请复制以下内容并发送给所在区域的负责老师，或点击下方电话直接咨询。</p>
                <pre id="signup-result-text"></pre>
                <div class="result-actions">
                  <button type="button" id="copy-btn" class="result-btn">复制报名信息</button>
                  <a id="result-call" class="result-btn ghost" href="tel:15088850940">联系负责老师</a>
                </div>
                <p class="result-teacher" id="result-teacher"></p>
              </div>
            </div>
          </div>
        </div>

        <div class="sec-block">
          <h2 class="sec-title">报名方式</h2>
          <div class="major-cols">
            <div class="info-card">
              <h3>到校咨询报名</h3>
              <p class="card-text">宁波市区 3 家分校、6 个接待点均可现场咨询与办理报名，建议先到校做免费学历规划。</p>
              <a class="portal-more" href="/contact/">查看校区与联系人 »</a>
            </div>
            <div class="info-card">
              <h3>报名提醒</h3>
              <p class="card-text">成人高考报名时间集中、考位有限，建议提前准备材料；报名政策以浙江省教育考试院当年公布为准。</p>
              <a class="portal-more" href="/notices/">查看教务通知 »</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>

<style>
  .signup-container { max-width: 1100px; }
  .sec-block { margin-bottom: 2.6rem; }
  .card-text { margin-top: 0.75rem; color: var(--color-text-muted); line-height: 1.9; font-size: 0.93rem; }
  .portal-more { display: inline-block; margin-top: 1rem; color: var(--color-primary); font-size: 0.88rem; }
  .signup-layout { display: grid; grid-template-columns: 15rem minmax(0, 1fr); gap: 1.6rem; align-items: start; }
  .signup-qr {
    padding: 1.4rem; background: #F7FAFE; border: 1px solid #E4ECF6; border-radius: 0.75rem; text-align: center;
  }
  .signup-qr img { display: block; width: 9rem; height: 9rem; margin: 0 auto 1rem; background: #fff; border-radius: 0.5rem; }
  .signup-qr h3 { font-size: 1rem; color: #16437D; margin-bottom: 0.6rem; }
  .signup-qr p { font-size: 0.8rem; line-height: 1.8; color: var(--color-text-muted); text-align: left; }
  .qr-link { display: inline-block; margin-top: 0.9rem; font-size: 0.82rem; color: var(--color-primary); }
  .signup-form {
    display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem 1.1rem;
    padding: 1.6rem; background: #fff; border: 1px solid #E4ECF6; border-radius: 0.75rem;
    box-shadow: 0 6px 22px rgba(23, 63, 116, 0.06);
  }
  .form-row { display: flex; flex-direction: column; gap: 0.4rem; min-width: 0; }
  .form-row.full, .form-actions { grid-column: 1 / -1; }
  .form-row label { font-size: 0.84rem; font-weight: 600; color: #2B3E56; }
  .form-row label em { color: #C0392B; font-style: normal; }
  .form-row input, .form-row select, .form-row textarea {
    width: 100%; padding: 0.62rem 0.8rem; border: 1px solid #DCE6F3; border-radius: 0.45rem;
    font-family: inherit; font-size: 0.88rem; color: var(--color-text); background: #fff;
  }
  .form-row input:focus, .form-row select:focus, .form-row textarea:focus { outline: 2px solid rgba(46, 111, 191, 0.28); border-color: var(--color-primary); }
  .form-row textarea { resize: vertical; }
  .form-actions { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .submit-btn { padding: 0.7rem 1.9rem; border: none; border-radius: 999px; background: #1D4E89; color: #fff; font-family: inherit; font-size: 0.92rem; font-weight: 600; cursor: pointer; }
  .submit-btn:hover { background: #16437D; }
  .form-note { font-size: 0.76rem; color: #9AA7B8; line-height: 1.6; }
  .signup-result { margin-top: 1.1rem; padding: 1.3rem 1.5rem; background: #F7FAFE; border: 1px solid #C9DFF5; border-left: 4px solid var(--color-primary); border-radius: 0.7rem; }
  .signup-result[hidden] { display: none; }
  .signup-result h3 { font-size: 1.1rem; color: #16437D; margin-bottom: 0.5rem; }
  .result-text { font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.8; }
  .signup-result pre {
    margin: 0.9rem 0; padding: 0.9rem 1rem; background: #fff; border: 1px dashed #C9D9EE; border-radius: 0.5rem;
    font-family: inherit; font-size: 0.85rem; line-height: 1.9; white-space: pre-wrap; word-break: break-all; color: #2B3E56;
  }
  .result-actions { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .result-btn { display: inline-block; padding: 0.55rem 1.3rem; border: none; border-radius: 999px; background: #1D4E89; color: #fff; font-family: inherit; font-size: 0.85rem; text-decoration: none; cursor: pointer; }
  .result-btn.ghost { background: #fff; color: #1D4E89; border: 1px solid #C9D9EE; }
  .result-teacher { margin-top: 0.8rem; font-size: 0.84rem; color: #7A5B18; }
  @media (max-width: 900px) {
    .signup-layout { grid-template-columns: 1fr; }
    .signup-qr { display: grid; grid-template-columns: 6rem 1fr; text-align: left; column-gap: 1rem; }
    .signup-qr img { width: 6rem; height: 6rem; grid-row: span 3; margin: 0; }
  }
  @media (max-width: 560px) {
    .signup-form { grid-template-columns: 1fr; }
    .signup-qr { display: block; text-align: center; }
    .signup-qr img { margin: 0 auto 1rem; }
  }
</style>

<script define:vars={{ districtContacts }}>
  const form = document.getElementById('signup-form');
  const result = document.getElementById('signup-result');
  const resultText = document.getElementById('signup-result-text');
  const resultTeacher = document.getElementById('result-teacher');
  const callLink = document.getElementById('result-call');
  const copyBtn = document.getElementById('copy-btn');

  // 首页引导表单 / 院校与项目「咨询」按钮带入的参数预填
  const params = new URLSearchParams(window.location.search);
  const preset = {
    name: params.get('name') || '',
    phone: params.get('phone') || '',
    level: params.get('level') || '',
    major: params.get('school') || params.get('project') || '',
  };
  if (preset.name) form.elements.name.value = preset.name;
  if (preset.phone) form.elements.phone.value = preset.phone;
  if (preset.major) form.elements.major.value = preset.major;
  if (preset.level) {
    const level = form.elements.level;
    if ([...level.options].some((o) => o.value === preset.level)) level.value = preset.level;
  }
  if (params.get('project') === '同等学力申硕' || params.get('project') === '在职研究生') {
    form.elements.level.value = '在职研究生';
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const get = (key) => String(data.get(key) || '').trim();
    const district = get('district');
    const contact = districtContacts.find((c) => c.district === district) || districtContacts[0];
    const lines = [
      '【硕学教育 · 报名意向】',
      `姓名：${get('name')}`,
      `手机：${get('phone')}`,
      `最高学历：${get('education') || '未填写'}`,
      `意向层次：${get('level') || '未填写'}`,
      `意向院校 / 专业 / 项目：${get('major') || '待老师推荐'}`,
      `所在区域：${district || '未选择'}`,
      `补充说明：${get('note') || '无'}`,
    ];
    resultText.textContent = lines.join('\n');
    resultTeacher.textContent = `${contact.district}负责老师：${contact.teacher} ${contact.phone}`;
    callLink.href = `tel:${contact.phone}`;
    callLink.textContent = `联系${contact.teacher} ${contact.phone}`;
    result.hidden = false;
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(resultText.textContent || '');
      copyBtn.textContent = '已复制 ✓';
      setTimeout(() => { copyBtn.textContent = '复制报名信息'; }, 2000);
    } catch (e) {
      copyBtn.textContent = '请手动长按复制';
    }
  });
</script>
