---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import ProductCard from '../../components/ProductCard.astro';
import { servicePromise } from '../../data/contacts';
import {
  getLocaleConfig,
  getProducts,
  getProductsPage,
  getSiteSettings,
} from '../../lib/site-content';

const { defaultLocale } = await getLocaleConfig();
const site = await getSiteSettings(defaultLocale);
const products = await getProducts(defaultLocale, site.defaultLocale);
const page = await getProductsPage(defaultLocale, site.defaultLocale);
const emptyNote = page.emptyNote || (site.defaultLocale.toLowerCase().startsWith('zh')
  ? '内容整理中，欢迎联系我们。'
  : 'Products are being prepared. Please get in touch.');
---

<Layout
  title={page.seoTitle || page.title}
  description={page.seoDescription || page.body || site.defaultMetaDescription}
  lang={defaultLocale}
  siteName={site.brandName}
  defaultDescription={site.defaultMetaDescription}
  faviconHref={site.logoPath}
  ogImage={site.defaultOgImage}
>
  <Navbar site={site} locale={defaultLocale} currentPath="/products" />
  <main id="main" class="products-page">
    <section class="page-hero">
      <div class="container">
        {page.kicker && <span class="section-kicker">{page.kicker}</span>}
        <h1 class="page-title">{page.title}</h1>
        {page.body && <p class="page-body">{page.body}</p>}
      </div>
    </section>

    <section class="section-padding products-list">
      <div class="container">
        {products.length > 0 ? (
          <div class="product-grid">
            {products.map((product) => (
              <ProductCard
                title={product.title}
                brand={product.brand}
                oneLiner={product.oneLiner}
                keywords={product.keywords}
                mainImage={product.mainImage}
                slug={product.slug || ''}
                locale={defaultLocale}
                defaultLocale={site.defaultLocale}
              />
            ))}
          </div>
        ) : (
          <p class="empty-note">{emptyNote}</p>
        )}
      </div>
    </section>

    <!-- 反馈：服务文案 -->
    <section class="service-band">
      <div class="container">
        <h2>我们的教学服务</h2>
        <p class="service-lead">{servicePromise}</p>
        <p class="service-note">从选校选专业、报考材料预审，到考前辅导、学籍注册与在读教务跟进，硕学教务团队全程专人对接，让在职学习更省心。</p>
        <a class="service-cta" href="/signup/">立即咨询 →</a>
      </div>
    </section>
  </main>
  <Footer site={site} locale={defaultLocale} />
</Layout>

<style>
  /* 反馈「对齐」：去掉多余的 5.5rem 顶部留白，与其他内页横幅对齐 */
  .products-page {
    padding-top: 0;
  }

  .page-hero {
    padding: 4.5rem 1rem 4.2rem;
  }

  .service-band { padding: 2.8rem 0 3.4rem; background: var(--color-bg); text-align: center; }
  .service-band h2 { font-size: 1.5rem; color: #16437D; margin-bottom: 1rem; }
  .service-lead {
    max-width: 52rem; margin: 0 auto; padding: 1rem 1.2rem;
    background: #FBF6EC; border: 1px solid #EBD9B4; border-radius: 0.6rem;
    color: #7A5B18; font-size: 0.95rem; line-height: 1.95;
  }
  .service-note { max-width: 52rem; margin: 0.9rem auto 0; font-size: 0.88rem; line-height: 1.9; color: var(--color-text-muted); }
  .service-cta { display: inline-block; margin-top: 1.3rem; padding: 0.65rem 1.6rem; border-radius: 999px; background: #1D4E89; color: #fff; font-size: 0.9rem; text-decoration: none; }
  .service-cta:hover { background: #16437D; }

  .section-kicker {
    display: block;
    margin-bottom: 0.9rem;
    color: rgba(214, 231, 255, 0.75);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
  }

  .page-title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 0.9rem;
  }

  .page-body {
    max-width: 46rem;
    margin: 0 auto;
    background: transparent;
    padding: 0;
    color: rgba(222, 235, 252, 0.82);
    line-height: 1.9;
  }

  .products-list {
    padding-top: 2.5rem;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  .empty-note {
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
